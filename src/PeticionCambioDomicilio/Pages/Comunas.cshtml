@page
@model PeticionCambioDomicilio.Pages.ComunasModel
@{
    ViewData["Title"] = "Comunas";
}

<h1 class="h3 mb-3">Directorio de correos municipales</h1>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h6">Agregar comuna</h2>
                <form method="post" class="row g-2">
                    <div class="col-12">
                        <input name="NuevaComuna" list="comunas-conocidas" class="form-control form-control-sm"
                               placeholder="Comuna (ej. ALGARROBO)" value="@Model.NuevaComuna" />
                        <datalist id="comunas-conocidas">
                            @foreach (var n in Model.Contactos.Select(c => c.Comuna).Distinct())
                            {
                                <option value="@n"></option>
                            }
                        </datalist>
                    </div>
                    <div class="col-12">
                        <input name="NuevoCorreo" type="email" class="form-control form-control-sm"
                               placeholder="correo@@municipio.cl" value="@Model.NuevoCorreo" />
                    </div>
                    <div class="col-12">
                        <button asp-page-handler="Agregar" class="btn btn-sm btn-primary">Agregar</button>
                        <span class="small text-muted">El dominio se saca del correo.</span>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h2 class="h6">Importar desde el Excel</h2>
                <p class="small text-muted mb-2">
                    Lee la hoja <code>CORREOS CAMBIO DE DOMICLIO</code> del libro y agrega las comunas que falten.
                    No borra ni pisa las que ya están.
                </p>
                <form method="post">
                    <button asp-page-handler="ImportarDesdeExcel" class="btn btn-sm btn-outline-primary"
                            disabled="@(Model.ExcelDisponible ? null : "disabled")">Importar comunas del Excel</button>
                    @if (!Model.ExcelDisponible)
                    {
                        <div class="small text-warning">Falta configurar <code>Peticion:ExcelPath</code>.</div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>

<form method="get" class="mb-3">
    <div class="input-group" style="max-width: 420px;">
        <input type="text" name="q" value="@Model.Q" class="form-control" placeholder="Buscar comuna o correo" />
        <button class="btn btn-outline-primary">Buscar</button>
    </div>
</form>

<table class="table table-sm table-striped">
    <thead><tr><th>Comuna</th><th>Correo</th><th>Dominio</th></tr></thead>
    <tbody>
    @foreach (var c in Model.Contactos)
    {
        <tr><td>@c.Comuna</td><td>@c.Email</td><td>@c.Domain</td></tr>
    }
    </tbody>
</table>
<p class="text-muted small">@Model.Contactos.Count registros. Se guardan en <code>data/comunas.csv</code>.</p>
