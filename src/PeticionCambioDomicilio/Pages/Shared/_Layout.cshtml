@inject PeticionCambioDomicilio.AppOptions Options
@inject PeticionCambioDomicilio.Ews.IMailSender Mail
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Petición Cambio de Domicilio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">Petición Cambio de Domicilio</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Index">Peticiones</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Comunas">Comunas</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Configuracion">Configuración</a></li>
                    </ul>
                    @{
                        // Single-file exe: Assembly.Location viene vacio; se usa la ruta del proceso.
                        DateTime? buildStamp = null;
                        try
                        {
                            var exe = Environment.ProcessPath;
                            if (!string.IsNullOrEmpty(exe) && System.IO.File.Exists(exe))
                            {
                                buildStamp = System.IO.File.GetLastWriteTime(exe);
                            }
                        }
                        catch { }
                    }
                    @if (buildStamp is not null)
                    {
                        <span class="navbar-text small text-muted">v @buildStamp.Value.ToString("dd-MM HH:mm")</span>
                    }
                </div>
            </div>
        </nav>
    </header>
    @{
        var envioReal = Mail.IsConfigured && string.IsNullOrWhiteSpace(Options.TestModeEmail);
        var modoPrueba = !string.IsNullOrWhiteSpace(Options.TestModeEmail);
    }
    @if (envioReal)
    {
        <div class="w-100 text-center fw-bold text-dark py-1" style="background:#ffc107;letter-spacing:.5px;">
            ⚠ ENVÍO REAL ACTIVO — los correos salen a las municipalidades
        </div>
    }
    else if (modoPrueba)
    {
        <div class="w-100 text-center fw-bold text-white py-1" style="background:#dc3545;letter-spacing:.5px;">
            MODO PRUEBA — nada llega a las municipalidades (todo va a @Options.TestModeEmail)
        </div>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Flash"] is string flash)
            {
                <div class="alert alert-info">@flash</div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // No saltar al tope cuando una accion recarga la pagina: guardar el scroll antes de
        // enviar cualquier formulario y volver a esa posicion al cargar. Tambien deja el foco
        // cerca de la fila donde se hizo la accion.
        (function () {
            var KEY = "scroll:" + location.pathname;
            document.addEventListener("submit", function () {
                try { sessionStorage.setItem(KEY, String(window.scrollY)); } catch (e) {}
            }, true);
            window.addEventListener("DOMContentLoaded", function () {
                var y;
                try { y = sessionStorage.getItem(KEY); sessionStorage.removeItem(KEY); } catch (e) {}
                if (y !== null && y !== undefined) {
                    window.scrollTo(0, parseInt(y, 10) || 0);
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
