@page
@model PeticionCambioDomicilio.Pages.IndexModel
@using PeticionCambioDomicilio.Domain
@{
    ViewData["Title"] = "Peticiones";
}

<h1 class="h3 mb-3">Peticiones de cambio de domicilio</h1>

@if (Model.ModoPruebaEmail is not null)
{
    <div class="alert alert-danger py-2">
        <strong>MODO PRUEBA ACTIVO.</strong> Ningun correo sale hacia las municipalidades.
        Todo se desvia a <code>@Model.ModoPruebaEmail</code>.
        Para enviar de verdad, vaciar <code>Peticion:TestModeEmail</code> en appsettings.Local.json.
    </div>
}

<div class="row mb-3">
    <div class="col">
        @if (!Model.MailListo)
        {
            <span class="badge bg-warning text-dark">Correo EWS sin configurar</span>
        }
        else
        {
            <span class="badge bg-success">Correo EWS listo</span>
        }
        <span class="badge bg-secondary">@Model.ComunasEnDirectorio comunas en directorio</span>
        @if (Model.ExcelConfigurado)
        {
            <span class="badge bg-secondary">Excel: @System.IO.Path.GetFileName(Model.ExcelPath)</span>
        }
        else
        {
            <span class="badge bg-warning text-dark">Excel sin configurar</span>
        }
    </div>
</div>

<div class="toolbar d-flex flex-wrap align-items-center gap-2 mb-2">
    <form method="post">
        <button asp-page-handler="Importar" class="btn btn-sm btn-primary">Importar / actualizar desde Excel</button>
    </form>
    <form method="post" onsubmit="return confirm('¿Enviar correo a todas las comunas de las peticiones pendientes?');">
        <button asp-page-handler="EnviarTodas" class="btn btn-sm btn-outline-primary">Enviar todas las pendientes</button>
    </form>
    <a href="/Imprimir" target="_blank" class="btn btn-sm btn-outline-secondary">Imprimir lista</a>
    <a href="/Imprimir?marcadas=true" target="_blank" class="btn btn-sm btn-outline-secondary">Imprimir marcadas</a>
    <span class="text-muted small ms-1">@Model.Peticiones.Count peticiones</span>
    <form method="post" class="ms-auto" onsubmit="return confirm('¿BORRAR las @Model.Peticiones.Count peticiones cargadas? El Excel NO se toca: podés reimportar cuando quieras. Esto solo limpia la lista del dashboard.');">
        <button asp-page-handler="BorrarTodo" class="btn btn-sm btn-outline-danger" disabled="@(Model.Peticiones.Count == 0 ? "disabled" : null)">
            Borrar todos los datos
        </button>
    </form>
</div>

<div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead>
        <tr>
            <th style="width:32px" class="text-center">✓</th>
            <th>Nombre</th>
            <th style="width:110px">RUT</th>
            <th style="width:130px">Comuna</th>
            <th style="width:92px">F. solicitud</th>
            <th style="width:130px">Envío</th>
            <th style="width:140px">Plazo · 15 d. háb.</th>
            <th style="width:110px">Origen</th>
            <th style="width:1%"></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Peticiones)
    {
        <tr id="fila-@p.Id" class="@(p.Marcada ? "table-info" : p.RutInvalido ? "table-warning" : "")">
            <td class="text-center">
                <form method="post" class="d-inline js-marcar" data-id="@p.Id">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button asp-page-handler="Marcar" class="btn btn-sm btn-link p-0 fs-5 text-decoration-none js-marcar-btn"
                            title="Marcar / desmarcar">@(p.Marcada ? "☑" : "☐")</button>
                </form>
            </td>
            <td>@p.NombreCompleto</td>
            <td class="col-rut">@p.Rut @(p.RutInvalido ? "⚠" : "")</td>
            <td>@p.Comuna</td>
            <td class="col-fecha">@(p.FechaSolicitud?.ToString("dd-MM-yyyy") ?? "—")</td>
            <td class="col-fecha">
                @if (p.Estado == EstadoPeticion.Enviada && p.EnviadaEn is not null)
                {
                    <strong>@p.EnviadaEn.Value.ToString("dd-MM-yyyy")</strong>
                    <div class="small text-muted">@p.EnviadaEn.Value.ToString("HH:mm")</div>
                }
                else if (p.Estado == EstadoPeticion.SinCorreoComuna)
                {
                    <span class="badge bg-warning text-dark">Sin correo comuna</span>
                }
                else if (p.Estado == EstadoPeticion.Error)
                {
                    <span class="badge bg-danger">Error</span>
                }
                else
                {
                    <span class="text-muted">Sin enviar</span>
                }
                @if (!string.IsNullOrEmpty(p.DetalleEstado))
                {
                    <div class="small text-muted">@p.DetalleEstado</div>
                }
            </td>
            <td>
                @{
                    var plazo = PeticionCambioDomicilio.Domain.PlazoInfo.Para(p);
                }
                @if (plazo.Inicio is null)
                {
                    <span class="text-muted">El reloj parte al enviar</span>
                }
                else
                {
                    var clasePlazo = plazo.Vencido ? "text-danger fw-bold"
                        : plazo.DiasRestantes <= 3 ? "text-warning fw-bold"
                        : "text-success";
                    <span class="@clasePlazo">
                        @if (plazo.Vencido)
                        {
                            <text>Vencido hace @(-plazo.DiasRestantes) d.</text>
                        }
                        else
                        {
                            <text>Quedan @plazo.DiasRestantes d.</text>
                        }
                    </span>
                    <div class="small text-muted">
                        Día @plazo.DiasTranscurridos de 15 · vence @plazo.Vence?.ToString("dd-MM-yyyy")
                    </div>
                }
            </td>
            <td title="@p.Origen" style="cursor:help">@p.Oficina</td>
            <td class="col-acciones">
                <form method="post" class="d-inline">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button asp-page-handler="Enviar" class="btn btn-sm btn-outline-primary"
                            disabled="@(p.Estado == EstadoPeticion.Enviada ? "disabled" : null)">Enviar</button>
                </form>
                <a href="/Imprimir?id=@p.Id" target="_blank" class="btn btn-sm btn-outline-secondary" title="Imprimir esta persona">🖨</a>
                <form method="post" class="d-inline" onsubmit="return confirm('¿Eliminar esta petición?');">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button asp-page-handler="Eliminar" class="btn btn-sm btn-outline-danger">✕</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Peticiones.Count == 0)
    {
        <tr><td colspan="9" class="text-center text-muted py-4">Sin peticiones. Importá desde el Excel.</td></tr>
    }
    </tbody>
</table>
</div>

@section Scripts {
<script>
    // Marcar/desmarcar sin recargar la pagina.

    document.querySelectorAll("form.js-marcar").forEach(function (form) {
        form.addEventListener("submit", function (ev) {
            ev.preventDefault();
            var id = form.dataset.id;
            var btn = form.querySelector(".js-marcar-btn");
            var url = form.getAttribute("action") || (location.pathname + "?handler=Marcar");
            var data = new FormData(form);
            var token = form.querySelector('input[name="__RequestVerificationToken"]');
            btn.disabled = true;
            fetch(url, {
                method: "POST",
                headers: { "X-Requested-With": "fetch", "RequestVerificationToken": token ? token.value : "" },
                body: data
            }).then(function (r) { return r.json(); })
              .then(function (res) {
                  btn.textContent = res.marcada ? "☑" : "☐";
                  var fila = document.getElementById("fila-" + id);
                  if (fila) {
                      fila.classList.toggle("table-info", res.marcada);
                  }
              }).catch(function () {
                  form.submit(); // si falla el fetch, envio normal
              }).finally(function () { btn.disabled = false; });
        });
    });
</script>
}
