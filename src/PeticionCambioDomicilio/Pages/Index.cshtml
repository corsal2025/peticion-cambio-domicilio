@page
@model PeticionCambioDomicilio.Pages.IndexModel
@using PeticionCambioDomicilio.Domain
@{
    ViewData["Title"] = "Peticiones";
    var total = Model.Peticiones.Count;
    var enviadas = Model.Peticiones.Count(p => p.Estado == EstadoPeticion.Enviada);
    var pendientes = total - enviadas;
    var vencidas = Model.Peticiones.Count(p => PlazoInfo.Para(p).Vencido);
}

<div class="d-flex align-items-end justify-content-between flex-wrap gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1">Peticiones de cambio de domicilio</h1>
        <div class="text-muted" style="font-size:.8rem;">Flujo saliente · Decreto 170, art. 14 · plazo legal 15 días hábiles</div>
    </div>
    <div class="stat-row">
        <div class="stat-chip"><b class="num">@total</b><span>Total</span></div>
        <div class="stat-chip stat-chip--soft"><b class="num">@pendientes</b><span>Pendientes</span></div>
        <div class="stat-chip stat-chip--ok"><b class="num">@enviadas</b><span>Enviadas</span></div>
        <div class="stat-chip stat-chip--bad"><b class="num">@vencidas</b><span>Vencidas</span></div>
    </div>
</div>

@if (Model.ModoPruebaEmail is not null)
{
    <div class="alert alert-danger">
        <strong>MODO PRUEBA ACTIVO.</strong> Ningún correo sale hacia las municipalidades.
        Todo se desvía a <code>@Model.ModoPruebaEmail</code>.
        Para enviar de verdad, vaciar <code>Peticion:TestModeEmail</code> en appsettings.Local.json.
    </div>
}

@if (Model.ComunasSinCorreo.Count > 0)
{
    <div class="alert alert-warning">
        <strong>⚠ @Model.ComunasSinCorreo.Count comuna(s) sin correo en el directorio:</strong>
        @string.Join(", ", Model.ComunasSinCorreo).
        Esas peticiones quedan en espera. Cargá el correo en
        <a asp-page="/Comunas">Comunas</a> y volvé a enviar — se retoman solas.
    </div>
}

@if (!Model.MailListo || !Model.ExcelConfigurado)
{
    <div class="d-flex flex-wrap gap-2 mb-3" style="font-size:.75rem;">
        @if (!Model.MailListo)
        {
            <span class="badge bg-warning">Correo EWS sin configurar</span>
        }
        @if (!Model.ExcelConfigurado)
        {
            <span class="badge bg-warning">Excel sin configurar</span>
        }
        <span class="badge bg-secondary">@Model.ComunasEnDirectorio comunas en directorio</span>
    </div>
}

<div class="toolbar mb-2">
    <form method="post">
        <button asp-page-handler="Importar" class="btn btn-sm btn-primary">Importar / actualizar desde Excel</button>
    </form>
    <form method="post">
        <button asp-page-handler="ActualizarCarpetas" class="btn btn-sm btn-outline-primary"
                title="Busca en el libro el estado de la carpeta de cada persona (por RUT) y lo actualiza si figura más avanzado">
            Actualizar carpetas desde el Excel
        </button>
    </form>
    <form method="post" onsubmit="return confirm('Se envía UN correo por comuna con las personas MARCADAS (✓) de esa comuna@(Model.ModoPruebaEmail is null ? "" : " (MODO PRUEBA: nada llega a las municipalidades)"). ¿Continuar?');">
        <button asp-page-handler="EnviarMarcadas" class="btn btn-sm btn-outline-primary"
                disabled="@(Model.MarcadasPendientes == 0 ? "disabled" : null)">
            Enviar marcadas (@Model.MarcadasPendientes)
        </button>
    </form>
    <span class="spacer"></span>
    <a href="/Imprimir" target="_blank" class="btn btn-sm btn-outline-secondary">Imprimir lista</a>
    <a href="/Imprimir?marcadas=true" target="_blank" class="btn btn-sm btn-outline-secondary">Imprimir marcadas</a>
    <form method="post" onsubmit="return confirm('¿BORRAR las @Model.Peticiones.Count peticiones cargadas? Esto borra también el HISTORIAL DE ENVÍO (qué se mandó y cuándo). Se guarda un respaldo automático de la base antes. El Excel NO se toca.');">
        <button asp-page-handler="BorrarTodo" class="btn btn-sm btn-outline-danger" disabled="@(Model.Peticiones.Count == 0 ? "disabled" : null)">
            Borrar todos los datos
        </button>
    </form>
</div>

<div class="table-responsive">
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th class="text-center" style="width:1%">✓</th>
            <th>Nombre</th>
            <th>RUT</th>
            <th class="text-center">Comuna</th>
            <th>F. solicitud</th>
            <th>Envío</th>
            <th>Plazo · 15 d. háb.</th>
            <th>Estado carpeta</th>
            <th>Origen</th>
            <th style="width:1%"></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Peticiones)
    {
        var pendientesComuna = Model.PendientesPorComuna.TryGetValue(p.Comuna, out var n) ? n : 0;
        var esEnviada = p.Estado == EstadoPeticion.Enviada;
        var esResuelta = p.SubidaEn is not null;
        var claseFila = esResuelta
            ? "fila-resuelta"
            : p.Marcada
                ? "fila-marcada"
                : esEnviada
                    ? "fila-enviada"
                    : p.Estado == EstadoPeticion.SinCorreoComuna
                        ? "fila-sincorreo"
                        : p.Estado == EstadoPeticion.Error
                            ? "fila-error"
                            : p.RutInvalido
                                ? "fila-rutinvalido"
                                : "fila-pendiente";

        int? diasCierre = null;
        if (esResuelta && p.EnviadaEn is { } envio)
        {
            var iniCierre = DateOnly.FromDateTime(envio.LocalDateTime);
            diasCierre = p.SubidaEn!.Value <= iniCierre
                ? 0
                : DeadlineCalculator.BusinessDaysBetween(iniCierre, p.SubidaEn.Value);
        }

        var plazo = PlazoInfo.Para(p);
        var pct = plazo.Inicio is null
            ? 0
            : Math.Clamp(plazo.DiasTranscurridos * 100 / DeadlineCalculator.PlazoDiasHabiles, 0, 100);
        var plazoClase = plazo.Inicio is null
            ? "plazo--idle"
            : plazo.Vencido ? "plazo--bad" : plazo.DiasRestantes <= 3 ? "plazo--warn" : "plazo--ok";
        var envioTitulo = !string.IsNullOrEmpty(p.DetalleEstado) ? p.DetalleEstado : null;

        <tr id="fila-@p.Id" class="@claseFila">
            <td class="text-center">
                <form method="post" class="d-inline js-marcar" data-id="@p.Id">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button asp-page-handler="Marcar" class="btn btn-sm btn-link p-0 text-decoration-none js-marcar-btn"
                            title="Marcar / desmarcar">@(p.Marcada ? "☑" : "☐")</button>
                </form>
            </td>
            <td class="dato">@p.NombreCompleto</td>
            <td class="dato num">@p.Rut @(p.RutInvalido ? "⚠" : "")</td>
            <td class="text-center"><span class="comuna-chip">@p.Comuna</span></td>
            <td class="num">@(p.FechaSolicitud?.ToString("dd-MM-yyyy") ?? "—")</td>
            <td>
                @if (p.Estado == EstadoPeticion.Enviada && p.EnviadaEn is not null)
                {
                    <span class="pill pill--ok" title="@envioTitulo" style="cursor:help">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5" /></svg>Enviado
                    </span>
                    <span class="pill-time num">@p.EnviadaEn.Value.ToString("dd-MM HH:mm")</span>
                }
                else if (p.Estado == EstadoPeticion.SinCorreoComuna)
                {
                    <span class="pill pill--warn" title="@envioTitulo" style="cursor:help">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v5" /><path d="M12 17h.01" /></svg>Sin correo comuna
                    </span>
                }
                else if (p.Estado == EstadoPeticion.Error)
                {
                    <span class="pill pill--bad" title="@envioTitulo" style="cursor:help">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>Error
                    </span>
                }
                else
                {
                    <span class="pill pill--idle">Sin enviar</span>
                }
            </td>
            <td>
                @if (esResuelta)
                {
                    <span class="plazo-txt" style="color:var(--done-ink);font-weight:700;" title="Carpeta subida el @p.SubidaEn!.Value.ToString("dd-MM-yyyy")">
                        ✓ Cerrada@(diasCierre is not null ? $" · {diasCierre} d. háb." : "")
                    </span>
                }
                else if (plazo.Inicio is null)
                {
                    <span class="plazo-txt text-muted">El reloj parte al enviar</span>
                }
                else
                {
                    <div class="plazo @plazoClase" title="Día @plazo.DiasTranscurridos de 15 · vence @plazo.Vence?.ToString("dd-MM-yyyy")" style="cursor:help">
                        <div class="plazo-bar"><i style="width:@(pct)%"></i></div>
                        <span class="plazo-txt">@(plazo.Vencido ? $"Vencido hace {-plazo.DiasRestantes} d." : $"Quedan {plazo.DiasRestantes} d.")</span>
                    </div>
                }
            </td>
            <td>
                @{
                    var opcionActual = EstadoCarpetaCatalog.OpcionDashboard(p.EstadoCarpeta);
                    string EtiquetaCarpeta(string v) => v switch
                    {
                        EstadoCarpetaCatalog.SubidaConaset => "Subida a CONASET",
                        EstadoCarpetaCatalog.SubidaCorreo => "Subida con correo",
                        _ => "— sin subir —",
                    };
                }
                <form method="post" asp-page-handler="EstadoCarpeta" class="carpeta-form d-inline">
                    <input type="hidden" name="id" value="@p.Id" />
                    <select name="estado" class="carpeta-select" title="Estado de la carpeta" onchange="this.form.submit()">
                        @foreach (var v in EstadoCarpetaCatalog.OpcionesDashboard)
                        {
                            <option value="@v" selected="@(opcionActual == v ? "selected" : null)">@EtiquetaCarpeta(v)</option>
                        }
                    </select>
                </form>
                @if (p.SubidaEn is not null)
                {
                    <div class="carpeta-fecha num">subida @p.SubidaEn.Value.ToString("dd-MM-yyyy")</div>
                }
            </td>
            <td class="text-muted" title="@p.Origen" style="cursor:help; font-size:.78rem;">@p.Oficina</td>
            <td class="col-acciones">
                @if (esEnviada)
                {
                    <span class="pill pill--ok">✓ Enviada</span>
                }
                else if (pendientesComuna > 0)
                {
                    var rutDudoso = Model.Peticiones.Any(x =>
                        x.Comuna.Equals(p.Comuna, System.StringComparison.OrdinalIgnoreCase)
                        && x.RutInvalido
                        && x.Estado != EstadoPeticion.Enviada);
                    var aviso = rutDudoso ? "\\n(incluye 1 o más con RUT NO validado)" : "";
                    <form method="post" class="d-inline"
                          onsubmit="return confirm('@p.Comuna: @pendientesComuna persona(s) pendiente(s).\nSe envía 1 correo con todas.@(aviso) ¿Continuar?');">
                        <input type="hidden" name="id" value="@p.Id" />
                        <button asp-page-handler="EnviarComuna" class="btn btn-sm btn-outline-primary">
                            Enviar comuna (@pendientesComuna)
                        </button>
                    </form>
                }
                <form method="post" class="d-inline" onsubmit="return confirm('¿Eliminar esta petición?');">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button asp-page-handler="Eliminar" class="btn btn-sm btn-outline-danger" title="Eliminar">✕</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Peticiones.Count == 0)
    {
        <tr><td colspan="10" class="text-center text-muted py-4">Sin peticiones. Importá desde el Excel.</td></tr>
    }
    </tbody>
</table>
</div>
<div class="d-flex justify-content-between text-muted mt-2" style="font-size:.75rem;">
    <span>Pendientes arriba en el orden del Excel · enviadas abajo por fecha de envío, la más nueva primero</span>
    <span>Respaldo automático de la base antes de importar o borrar</span>
</div>

@section Scripts {
<script>
    // Marcar/desmarcar sin recargar la pagina.

    document.querySelectorAll("form.js-marcar").forEach(function (form) {
        form.addEventListener("submit", function (ev) {
            ev.preventDefault();
            var id = form.dataset.id;
            var btn = form.querySelector(".js-marcar-btn");
            var url = form.getAttribute("action") || (location.pathname + "?handler=Marcar");
            var data = new FormData(form);
            var token = form.querySelector('input[name="__RequestVerificationToken"]');
            btn.disabled = true;
            fetch(url, {
                method: "POST",
                headers: { "X-Requested-With": "fetch", "RequestVerificationToken": token ? token.value : "" },
                body: data
            }).then(function (r) { return r.json(); })
              .then(function (res) {
                  btn.textContent = res.marcada ? "☑" : "☐";
                  var fila = document.getElementById("fila-" + id);
                  if (fila) {
                      fila.classList.toggle("fila-marcada", res.marcada);
                  }
              }).catch(function () {
                  form.submit(); // si falla el fetch, envio normal
              }).finally(function () { btn.disabled = false; });
        });
    });
</script>
}
