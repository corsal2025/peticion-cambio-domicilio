@page
@model PeticionCambioDomicilio.Pages.IndexModel
@using PeticionCambioDomicilio.Domain
@{
    ViewData["Title"] = "Peticiones";
}

<h1 class="h3 mb-3">Peticiones de cambio de domicilio</h1>

@if (Model.ModoPruebaEmail is not null)
{
    <div class="alert alert-danger py-2">
        <strong>MODO PRUEBA ACTIVO.</strong> Ningun correo sale hacia las municipalidades.
        Todo se desvia a <code>@Model.ModoPruebaEmail</code>.
        Para enviar de verdad, vaciar <code>Peticion:TestModeEmail</code> en appsettings.Local.json.
    </div>
}

<div class="row mb-3">
    <div class="col">
        @if (!Model.MailListo)
        {
            <span class="badge bg-warning text-dark">Correo EWS sin configurar</span>
        }
        else
        {
            <span class="badge bg-success">Correo EWS listo</span>
        }
        <span class="badge bg-secondary">@Model.ComunasEnDirectorio comunas en directorio</span>
        @if (Model.ExcelConfigurado)
        {
            <span class="badge bg-secondary">Excel: @System.IO.Path.GetFileName(Model.ExcelPath)</span>
        }
        else
        {
            <span class="badge bg-warning text-dark">Excel sin configurar</span>
        }
    </div>
</div>

<form method="post" class="d-inline">
    <button asp-page-handler="Importar" class="btn btn-primary">Importar / actualizar desde Excel</button>
</form>
<form method="post" class="d-inline" onsubmit="return confirm('¿Enviar correo a todas las comunas de las peticiones pendientes?');">
    <button asp-page-handler="EnviarTodas" class="btn btn-outline-primary">Enviar todas las pendientes</button>
</form>
<form method="post" class="d-inline float-end" onsubmit="return confirm('¿BORRAR las @Model.Peticiones.Count peticiones cargadas? El Excel NO se toca: podés reimportar cuando quieras. Esto solo limpia la lista del dashboard.');">
    <button asp-page-handler="BorrarTodo" class="btn btn-outline-danger" disabled="@(Model.Peticiones.Count == 0 ? "disabled" : null)">
        Borrar todos los datos
    </button>
</form>

<table class="table table-sm table-hover mt-3 align-middle">
    <thead>
        <tr>
            <th style="width:1%">Marcar</th>
            <th>Nombre</th>
            <th>RUT</th>
            <th>Comuna</th>
            <th>Fecha solicitud</th>
            <th>Estado</th>
            <th>Origen</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Peticiones)
    {
        <tr id="fila-@p.Id" class="@(p.Marcada ? "table-info" : p.RutInvalido ? "table-warning" : "")">
            <td class="text-center">
                <form method="post" class="d-inline js-marcar" data-id="@p.Id">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button asp-page-handler="Marcar" class="btn btn-sm btn-link p-0 fs-5 text-decoration-none js-marcar-btn"
                            title="Marcar / desmarcar">@(p.Marcada ? "☑" : "☐")</button>
                </form>
            </td>
            <td>@p.NombreCompleto</td>
            <td>@p.Rut @(p.RutInvalido ? "⚠" : "")</td>
            <td>@p.Comuna</td>
            <td>@(p.FechaSolicitud?.ToString("dd-MM-yyyy") ?? "—")</td>
            <td>
                @{
                    var badge = p.Estado switch
                    {
                        EstadoPeticion.Enviada => "bg-success",
                        EstadoPeticion.SinCorreoComuna => "bg-warning text-dark",
                        EstadoPeticion.Error => "bg-danger",
                        _ => "bg-secondary"
                    };
                }
                <span class="badge @badge">@p.Estado</span>
                @if (!string.IsNullOrEmpty(p.DetalleEstado))
                {
                    <div class="small text-muted">@p.DetalleEstado</div>
                }
                @if (p.Estado == EstadoPeticion.Enviada && p.EnviadaEn is not null)
                {
                    <div class="small text-muted">@p.EnviadaEn.Value.ToString("dd-MM-yyyy HH:mm") → @p.DestinatariosCorreo</div>
                }
            </td>
            <td title="@p.Origen" style="cursor:help">@p.Oficina</td>
            <td class="text-nowrap">
                <form method="post" class="d-inline">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button asp-page-handler="Enviar" class="btn btn-sm btn-outline-primary"
                            disabled="@(p.Estado == EstadoPeticion.Enviada ? "disabled" : null)">Enviar</button>
                </form>
                <form method="post" class="d-inline">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button asp-page-handler="Borrador" class="btn btn-sm btn-outline-secondary"
                            title="Descargar .eml y abrirlo en Outlook">Borrador</button>
                </form>
                <form method="post" class="d-inline" onsubmit="return confirm('¿Eliminar esta petición?');">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button asp-page-handler="Eliminar" class="btn btn-sm btn-outline-danger">✕</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Peticiones.Count == 0)
    {
        <tr><td colspan="8" class="text-center text-muted py-4">Sin peticiones. Importá desde el Excel.</td></tr>
    }
    </tbody>
</table>

@section Scripts {
<script>
    // Marcar/desmarcar sin recargar la pagina.
    document.querySelectorAll("form.js-marcar").forEach(function (form) {
        form.addEventListener("submit", function (ev) {
            ev.preventDefault();
            var id = form.dataset.id;
            var btn = form.querySelector(".js-marcar-btn");
            var url = form.getAttribute("action") || (location.pathname + "?handler=Marcar");
            var data = new FormData(form);
            var token = form.querySelector('input[name="__RequestVerificationToken"]');
            btn.disabled = true;
            fetch(url, {
                method: "POST",
                headers: { "X-Requested-With": "fetch", "RequestVerificationToken": token ? token.value : "" },
                body: data
            }).then(function (r) { return r.json(); })
              .then(function (res) {
                  btn.textContent = res.marcada ? "☑" : "☐";
                  var fila = document.getElementById("fila-" + id);
                  if (fila) {
                      fila.classList.toggle("table-info", res.marcada);
                  }
              }).catch(function () {
                  form.submit(); // si falla el fetch, envio normal
              }).finally(function () { btn.disabled = false; });
        });
    });
</script>
}
