@page
@model PeticionCambioDomicilio.Pages.IndexModel
@using PeticionCambioDomicilio.Domain
@{
    ViewData["Title"] = "Peticiones";
}

<h1 class="h3 mb-3">Peticiones de cambio de domicilio</h1>

@if (Model.ModoPruebaEmail is not null)
{
    <div class="alert alert-danger py-2">
        <strong>MODO PRUEBA ACTIVO.</strong> Ningun correo sale hacia las municipalidades.
        Todo se desvia a <code>@Model.ModoPruebaEmail</code>.
        Para enviar de verdad, vaciar <code>Peticion:TestModeEmail</code> en appsettings.Local.json.
    </div>
}

@if (Model.ComunasSinCorreo.Count > 0)
{
    <div class="alert alert-warning py-2">
        <strong>⚠ @Model.ComunasSinCorreo.Count comuna(s) sin correo en el directorio:</strong>
        @string.Join(", ", Model.ComunasSinCorreo).
        Esas peticiones quedan en espera. Cargá el correo en
        <a asp-page="/Comunas">Comunas</a> y volvé a enviar — se retoman solas.
    </div>
}

<div class="row mb-3">
    <div class="col">
        @if (!Model.MailListo)
        {
            <span class="badge bg-warning text-dark">Correo EWS sin configurar</span>
        }
        else
        {
            <span class="badge bg-success">Correo EWS listo</span>
        }
        <span class="badge bg-secondary">@Model.ComunasEnDirectorio comunas en directorio</span>
        @if (Model.ExcelConfigurado)
        {
            <span class="badge bg-secondary">Excel: @System.IO.Path.GetFileName(Model.ExcelPath)</span>
        }
        else
        {
            <span class="badge bg-warning text-dark">Excel sin configurar</span>
        }
    </div>
</div>

<div class="toolbar d-flex flex-wrap align-items-center gap-2 mb-2">
    <form method="post">
        <button asp-page-handler="Importar" class="btn btn-sm btn-primary">Importar / actualizar desde Excel</button>
    </form>
    <form method="post" onsubmit="return confirm('Se envía UN correo por comuna con todas sus personas pendientes@(Model.ModoPruebaEmail is null ? "" : " (MODO PRUEBA: nada llega a las municipalidades)"). ¿Continuar?');">
        <button asp-page-handler="EnviarTodas" class="btn btn-sm btn-outline-primary">Enviar todas las pendientes</button>
    </form>
    <a href="/Imprimir" target="_blank" class="btn btn-sm btn-outline-secondary">Imprimir lista</a>
    <a href="/Imprimir?marcadas=true" target="_blank" class="btn btn-sm btn-outline-secondary">Imprimir marcadas</a>
    <span class="text-muted small ms-1">@Model.Peticiones.Count peticiones</span>
    <span class="badge bg-success text-white py-1 px-2 ms-2">✓ @Model.Peticiones.Count(p => p.Estado == EstadoPeticion.Enviada) enviadas</span>
    <span class="badge bg-secondary text-white py-1 px-2 ms-1">⏳ @Model.Peticiones.Count(p => p.Estado != EstadoPeticion.Enviada) pendientes</span>
    <form method="post" class="ms-auto" onsubmit="return confirm('¿BORRAR las @Model.Peticiones.Count peticiones cargadas? Esto borra también el HISTORIAL DE ENVÍO (qué se mandó y cuándo). Se guarda un respaldo automático de la base antes. El Excel NO se toca.');">
        <button asp-page-handler="BorrarTodo" class="btn btn-sm btn-outline-danger" disabled="@(Model.Peticiones.Count == 0 ? "disabled" : null)">
            Borrar todos los datos
        </button>
    </form>
</div>

<div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead>
        <tr>
            <th class="text-center" style="width:1%">✓</th>
            <th>Nombre</th>
            <th>RUT</th>
            <th class="text-center">Comuna</th>
            <th>F. solicitud</th>
            <th>Envío</th>
            <th>Plazo · 15 d. háb.</th>
            <th>Origen</th>
            <th style="width:1%"></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Peticiones)
    {
        var pendientesComuna = Model.PendientesPorComuna.TryGetValue(p.Comuna, out var n) ? n : 0;
        var esEnviada = p.Estado == EstadoPeticion.Enviada;
        var claseFila = p.Marcada
            ? "table-info fila-marcada"
            : esEnviada
                ? "fila-enviada"
                : p.Estado == EstadoPeticion.SinCorreoComuna
                    ? "table-warning fila-sincorreo"
                    : p.Estado == EstadoPeticion.Error
                        ? "table-danger fila-error"
                        : p.RutInvalido
                            ? "table-warning fila-rutinvalido"
                            : "fila-pendiente";

        <tr id="fila-@p.Id" class="@claseFila">
            <td class="text-center">
                <form method="post" class="d-inline js-marcar" data-id="@p.Id">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button asp-page-handler="Marcar" class="btn btn-sm btn-link p-0 fs-5 text-decoration-none js-marcar-btn"
                            title="Marcar / desmarcar">@(p.Marcada ? "☑" : "☐")</button>
                </form>
            </td>
            <td class="dato">@p.NombreCompleto</td>
            <td class="dato text-center">@p.Rut @(p.RutInvalido ? "⚠" : "")</td>
            <td class="dato text-center">@p.Comuna</td>
            <td class="dato text-center">@(p.FechaSolicitud?.ToString("dd-MM-yyyy") ?? "—")</td>
            <td class="dato text-center">
                @{
                    var envioTitulo = !string.IsNullOrEmpty(p.DetalleEstado) ? p.DetalleEstado : null;
                }
                @if (p.Estado == EstadoPeticion.Enviada && p.EnviadaEn is not null)
                {
                    <span class="badge bg-success text-white px-2 py-1 shadow-sm" title="@envioTitulo" style="cursor:help">
                        ✓ Enviado (@p.EnviadaEn.Value.ToString("dd-MM-yyyy HH:mm"))
                    </span>
                }
                else if (p.Estado == EstadoPeticion.SinCorreoComuna)
                {
                    <span class="badge bg-warning text-dark px-2 py-1" title="@envioTitulo" style="cursor:help">⚠ Sin correo comuna</span>
                }
                else if (p.Estado == EstadoPeticion.Error)
                {
                    <span class="badge bg-danger text-white px-2 py-1" title="@envioTitulo" style="cursor:help">✕ Error</span>
                }
                else
                {
                    <span class="badge bg-light text-secondary border px-2 py-1 fw-semibold">⏳ Sin enviar</span>
                }
            </td>
            <td class="dato text-center">
                @{
                    var plazo = PeticionCambioDomicilio.Domain.PlazoInfo.Para(p);
                }
                @if (plazo.Inicio is null)
                {
                    <span class="text-muted fw-normal">El reloj parte al enviar</span>
                }
                else
                {
                    var clasePlazo = plazo.Vencido ? "text-danger" : plazo.DiasRestantes <= 3 ? "text-warning" : "text-success";
                    var plazoTitulo = $"Día {plazo.DiasTranscurridos} de 15 · vence {plazo.Vence?.ToString("dd-MM-yyyy")}";
                    <span class="@clasePlazo" title="@plazoTitulo" style="cursor:help">
                        @(plazo.Vencido ? $"Vencido hace {-plazo.DiasRestantes} d." : $"Quedan {plazo.DiasRestantes} d.")
                    </span>
                }
            </td>
            <td class="dato text-center" title="@p.Origen" style="cursor:help">@p.Oficina</td>
            <td class="col-acciones">
                @if (pendientesComuna > 0)
                {
                    var rutDudoso = Model.Peticiones.Any(x =>
                        x.Comuna.Equals(p.Comuna, System.StringComparison.OrdinalIgnoreCase)
                        && x.RutInvalido
                        && x.Estado != EstadoPeticion.Enviada);
                    var aviso = rutDudoso ? "\\n(incluye 1 o más con RUT NO validado)" : "";
                    <form method="post" class="d-inline"
                          onsubmit="return confirm('@p.Comuna: @pendientesComuna persona(s) pendiente(s).\nSe envía 1 correo con todas.@(aviso) ¿Continuar?');">
                        <input type="hidden" name="id" value="@p.Id" />
                        <button asp-page-handler="EnviarComuna" class="btn btn-sm btn-outline-primary">
                            Enviar comuna (@pendientesComuna)
                        </button>
                    </form>
                }
                else
                {
                    <button class="btn btn-sm btn-success text-white" disabled title="Todos los correos de esta comuna ya fueron enviados">✓ Enviada</button>
                }
                <form method="post" class="d-inline" onsubmit="return confirm('¿Eliminar esta petición?');">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button asp-page-handler="Eliminar" class="btn btn-sm btn-outline-danger">✕</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Peticiones.Count == 0)
    {
        <tr><td colspan="9" class="text-center text-muted py-4">Sin peticiones. Importá desde el Excel.</td></tr>
    }
    </tbody>
</table>
</div>

@section Scripts {
<script>
    // Marcar/desmarcar sin recargar la pagina.

    document.querySelectorAll("form.js-marcar").forEach(function (form) {
        form.addEventListener("submit", function (ev) {
            ev.preventDefault();
            var id = form.dataset.id;
            var btn = form.querySelector(".js-marcar-btn");
            var url = form.getAttribute("action") || (location.pathname + "?handler=Marcar");
            var data = new FormData(form);
            var token = form.querySelector('input[name="__RequestVerificationToken"]');
            btn.disabled = true;
            fetch(url, {
                method: "POST",
                headers: { "X-Requested-With": "fetch", "RequestVerificationToken": token ? token.value : "" },
                body: data
            }).then(function (r) { return r.json(); })
              .then(function (res) {
                  btn.textContent = res.marcada ? "☑" : "☐";
                  var fila = document.getElementById("fila-" + id);
                  if (fila) {
                      fila.classList.toggle("table-info", res.marcada);
                      fila.classList.toggle("fila-marcada", res.marcada);
                  }
              }).catch(function () {
                  form.submit(); // si falla el fetch, envio normal
              }).finally(function () { btn.disabled = false; });
        });
    });
</script>
}
